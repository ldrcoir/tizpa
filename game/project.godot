; Engine configuration file - Tiz Pa | تیز پا
config_version=5

[application]

config/name="Tiz Pa | تیز پا"
run/main_scene="res://scenes/aghaz.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

Saman="*res://scripts/saman.gd"
Sedasan="*res://scripts/sedasan.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]

locale/layout_direction=2

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
